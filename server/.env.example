# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/startup
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/startup?retryWrites=true&w=majority

# ---- Auth / JWT ----
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
CLIENT_URL=http://localhost:3000

# ---- Admin seed account ----
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# ---- Cloudinary (product image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
